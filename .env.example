# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection string. If unset, app/config.py builds it
# from the POSTGRES_* vars above using the psycopg driver.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/kb

# --- Redis (Celery broker/backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme12345
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kb-raw

# --- Zhipu Embedding-3 ---
# Required for ingestion and every ordinary knowledge question. Without it,
# deterministic channel commands still work, but knowledge questions fail closed.
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
# Keep model and dimensions aligned with existing segment vectors: vector(1536).
EMBEDDING_DIMENSIONS=1536
# Embedding-3 accepts at most 64 input strings per request.
EMBEDDING_BATCH_SIZE=64

# --- Knowledge retrieval Agent ---
# AGENT_MODEL accepts a PydanticAI model name. With AGENT_BASE_URL set, the
# provider is treated as an OpenAI-compatible endpoint.
AGENT_MODEL=openai:gpt-5-mini
AGENT_API_KEY=
# AGENT_BASE_URL=
AGENT_TIMEOUT_SECONDS=45
AGENT_REQUEST_LIMIT=6
AGENT_TOOL_CALLS_LIMIT=10
AGENT_OUTPUT_TOKEN_LIMIT=2000
CONTEXT_MAX_TURNS=8
CONTEXT_TOKEN_BUDGET=6000
CHANNEL_LINK_TTL_SECONDS=600

# Loopback bridge used by the thin LangBot plugin. Generate a long random value.
CHANNEL_GATEWAY_SECRET=
CHANNEL_GATEWAY_HOST=127.0.0.1
CHANNEL_GATEWAY_PORT=8765
