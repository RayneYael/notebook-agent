# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection string. If unset, app/config.py builds it
# from the POSTGRES_* vars above using the psycopg driver.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/kb

# --- Redis (Celery broker/backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0
# Total broker publish budget for channel save actions. It is clamped below
# AGENT_TIMEOUT_SECONDS; no unbounded connection/socket retry is allowed.
BROKER_PUBLISH_TIMEOUT_SECONDS=5
BROKER_PUBLISH_MAX_RETRIES=1

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme12345
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kb-raw

# --- Zhipu Embedding-3 ---
# Optional: a readable PEM bundle. Configure the same path in the gateway and
# Celery worker environments; certificate and hostname verification stay enabled.
# If omitted, each process uses its interpreter's certifi bundle.
# TLS_CA_BUNDLE=/absolute/path/to/cacert.pem
# Required for ingestion and every ordinary knowledge question. Without it,
# deterministic channel commands still work, but knowledge questions fail closed.
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
# Keep model and dimensions aligned with existing segment vectors: vector(1536).
EMBEDDING_DIMENSIONS=1536
# Embedding-3 accepts at most 64 input strings per request.
EMBEDDING_BATCH_SIZE=64

# --- Knowledge retrieval Agent ---
# Safe structured runtime diagnostics. Local gateway/CLI processes write this
# private directory and stdout; systemd deployments override it below.
NOTEBOOK_AGENT_LOG_DIR=.runtime/logs
NOTEBOOK_AGENT_LOG_MAX_BYTES=10485760
NOTEBOOK_AGENT_LOG_BACKUP_COUNT=5
NOTEBOOK_AGENT_ENV=production
NOTEBOOK_AGENT_LOG_RETRIEVAL_CONTENT=false
# Local-only retrieval diagnostics require BOTH:
# NOTEBOOK_AGENT_ENV=development
# NOTEBOOK_AGENT_LOG_RETRIEVAL_CONTENT=true
# AGENT_MODEL accepts a PydanticAI model name. With AGENT_BASE_URL set, the
# provider is treated as an OpenAI-compatible endpoint.
AGENT_MODEL=openai:gpt-5-mini
AGENT_API_KEY=
# AGENT_BASE_URL=
AGENT_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_REQUEST_LIMIT=8
AGENT_TOOL_CALLS_LIMIT=10
# The retrieval planner and tool-free answer composer each receive a fresh
# output-token budget. This is a per-stage safety limit, not a reason to raise
# the value to compensate for multi-step retrieval.
AGENT_OUTPUT_TOKEN_LIMIT=2000
# Real provider-side cap for each answer Composer request. Each full or
# compressed attempt can make at most two structured-output requests, so this
# value multiplied by 2 must not exceed the per-attempt safety limit above.
# A compression retry starts a fresh attempt under the same wall-clock timeout;
# the full workflow can therefore make at most four provider requests.
AGENT_COMPOSER_MAX_TOKENS=1000
# Keep disabled through migration, compatible worker startup, and gateway
# readiness. Enable only for the channel save smoke, then restart the gateway.
AGENT_SAVE_ENABLED=false
# Inventory/update/delete/restore/retry management rollout.  Deleted-content
# retrieval filters remain enabled when this is false.
AGENT_ITEM_MANAGEMENT_ENABLED=false
# Recycle-bin retention and bounded maintenance sweep.
TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_SECONDS=3600
TRASH_PURGE_BATCH_SIZE=20
TRASH_PURGE_CLAIM_TIMEOUT_SECONDS=1800
TRASH_PURGE_MAX_DURATION_SECONDS=30
TRASH_PURGE_OBJECT_TIMEOUT_SECONDS=10
CONTEXT_MAX_TURNS=8
CONTEXT_TOKEN_BUDGET=6000
CHANNEL_LINK_TTL_SECONDS=600

# Loopback bridge used by the thin LangBot plugin. Generate a long random value.
CHANNEL_GATEWAY_SECRET=
CHANNEL_GATEWAY_HOST=127.0.0.1
CHANNEL_GATEWAY_PORT=8765

# --- MCP core transport ---
# MCP is independent from the optional LangBot loopback bridge above.  stdio
# is the default local/source-evaluation mode; Streamable HTTP uses these
# values and serves the canonical endpoint at MCP_PATH.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Enable only when a URL-only evaluator cannot send Authorization headers.
# URL mode accepts /mcp/c/<opaque-token>; query-string credentials are never
# accepted. Use HTTPS and redact request URIs in any reverse proxy.
MCP_URL_TOKEN_MODE=false
