# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection string. If unset, app/config.py builds it
# from the POSTGRES_* vars above using the psycopg driver.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/kb

# --- Redis (Celery broker/backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme12345
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kb-raw

# --- OpenAI (embeddings) ---
OPENAI_API_KEY=
