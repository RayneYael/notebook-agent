+    @staticmethod
+    def _parse_required_plugins(value: Any) -> tuple[str, ...]:
+        if value is None:
+            return ()
+        if isinstance(value, str):
+            value = [item.strip() for item in value.split(',') if item.strip()]
+        if not isinstance(value, list):
+            raise RequiredPluginConfigurationError('plugin.required_plugins must be a list of author/name values')
+
+        required_plugins: list[str] = []
+        for item in value:
+            if not isinstance(item, str):
+                raise RequiredPluginConfigurationError('plugin.required_plugins entries must be strings')
+            plugin_ref = item.strip()
+            author, separator, plugin_name = plugin_ref.partition('/')
+            if not separator or not author or not plugin_name or '/' in plugin_name:
+                raise RequiredPluginConfigurationError(
+                    'plugin.required_plugins entries must use the author/name format'
+                )
+            if plugin_ref not in required_plugins:
+                required_plugins.append(plugin_ref)
+        return tuple(required_plugins)
