# Copy this file to the installed LangBot plugin directory as .env and chmod 600.
# Do not put real values in the repository, logs, screenshots, or LangBot core config.
CHANNEL_GATEWAY_SECRET=replace-with-the-same-long-random-secret-as-the-agent-service
CHANNEL_GATEWAY_URL=http://127.0.0.1:8765/v1/messages
# Map every enabled LangBot bot UUID to its trusted adapter type. Multiple
# channels can be enabled simultaneously; there is no default channel.
KB_BOT_CHANNELS={"telegram-bot-uuid":"telegram","wechat-bot-uuid":"wechat"}
