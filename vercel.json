{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "DEPLOYMENT_ENV": "competition",
    "EXPECTED_DATABASE_REVISION": "c7e8a91b2d34"
  },
  "functions": {
    "api/health.py": {
      "maxDuration": 30,
      "excludeFiles": "{.trellis,docs,integrations,tests}/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
