{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "env": {
    "DEPLOYMENT_ENV": "competition",
    "EXPECTED_DATABASE_REVISION": "f1a2b3c4d5e6"
  },
  "functions": {
    "api/health.py": {
      "maxDuration": 30,
      "excludeFiles": "{.agents/**,.claude/**,.codex/**,.env,.env.*,.git/**,.github/**,.pytest_cache/**,.trellis/**,.vercel/**,.venv/**,build/**,docs/**,integrations/**,tests/**,*.egg-info/**,AGENTS.md,README.md,README.zh-CN.md,docker-compose.yml,mermaid-diagram.svg}"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/health"
    },
    {
      "src": "^/health$",
      "dest": "/api/health"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/health"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
